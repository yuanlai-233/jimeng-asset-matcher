{
  "manifest_version": 3,
  "name": "即梦素材一键匹配",
  "version": "0.3.24",
  "description": "分步上传本地图片、视频和音频并手动匹配，在原文字后追加即梦/Dreamina 原生 @ 标签。",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jimeng.jianying.com/*",
        "https://dreamina.capcut.com/*"
      ],
      "js": [
        "media-files.js",
        "upload-bridge.js",
        "canvas-upload-bridge.js",
        "bgm-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jimeng.jianying.com/*",
        "https://dreamina.capcut.com/*"
      ],
      "js": [
        "media-files.js",
        "matcher.js",
        "runtime.js",
        "theme.js",
        "canvas.js",
        "onboarding.js",
        "local-assets.js",
        "local-directory.js",
        "local-workflow.js",
        "local-upload.js",
        "editor.js",
        "candidates.js",
        "native-trigger.js",
        "ui.js",
        "bgm.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://jimeng.jianying.com/*",
    "https://dreamina.capcut.com/*"
  ]
}
